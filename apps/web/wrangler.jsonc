{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The GMS web app is a static SPA served by Workers static assets.
  // `pnpm --filter @gms/web build` writes dist/.
  "name": "gms-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    // gms-staging.opengrants.io. The API Worker's routes on the same host take the API paths.
    "staging": {
      "name": "gms-web-staging",
      "routes": [{ "pattern": "gms-staging.opengrants.io", "custom_domain": true }]
    }
  }
}
