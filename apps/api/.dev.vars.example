# Copy to .dev.vars (gitignored) and fill in. Names only here; never commit values.
GMS_BASE_URL=http://localhost:8787
WEB_BASE_URL=http://localhost:5173

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# pnpm --filter @gms/api keygen
OAUTH_ISSUER=http://localhost:8787
OAUTH_KID=
OAUTH_SIGNING_KEY_JWK=
JWKS_EXTRA_PUBLIC_KEYS=
OAUTH_DCR_REDIRECT_HOSTS=

PASSPORT_BASE_URL=
PASSPORT_ISSUER=
PASSPORT_GMS_CLIENT_ID=
PASSPORT_GMS_CLIENT_SECRET=
PASSPORT_WEBHOOK_SECRET=
# "true" once Passport serves the funder award routes (award:write)
PASSPORT_AWARD_WRITE=false
# "true" adds payee:read to the applicant Passport consent (payout destination panel). Default off.
PASSPORT_APPLICANT_PAYEE_READ=true

# 32 random bytes, base64url, each
CREDENTIALS_ENCRYPTION_KEY=
WEBHOOK_SECRET_KEY=

OPENGRANTS_MCP_URL=https://mcp.opengrants.io/mcp
OPENGRANTS_API_KEY=
COMPOSIO_API_KEY=
COMPOSIO_GOOGLE_AUTH_CONFIG_ID=
# Import from Google Sheets and Airtable (read-only auth configs; docs/connectors.md)
COMPOSIO_GOOGLE_SHEETS_AUTH_CONFIG_ID=
COMPOSIO_AIRTABLE_AUTH_CONFIG_ID=
# Connected apps (v1.12.0, docs/connectors.md): each app is hidden until its auth config id is set.
# Slack and Calendar also on the jobs Worker, with COMPOSIO_API_KEY. Drive must be on the same Google
# OAuth client as the Picker (VITE_GOOGLE_OAUTH_CLIENT_ID in the web build).
COMPOSIO_SLACK_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_DRIVE_AUTH_CONFIG_ID=
COMPOSIO_SALESFORCE_AUTH_CONFIG_ID=
# Social posting through Zernio (docs/social.md); both, or social posting is hidden.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
# Template gallery moderators: comma-separated user ids or email addresses (a secret, never in wrangler.toml)
GALLERY_MODERATORS=
# Partner directory moderators (v1.12.0): optional; while unset or blank, GALLERY_MODERATORS moderate (a secret, never in wrangler.toml)
DIRECTORY_MODERATORS=
RESEND_INBOUND_SECRET=
# Domain that receives replies (thread+<id>@domain); defaults to the domain of RESEND_FROM
RESEND_INBOUND_DOMAIN=
ANTHROPIC_API_KEY=
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=
