{
  "name": "gms",
  "private": true,
  "version": "1.3.0",
  "description": "OpenGrants GMS: free, open-source grants management for funders and awardees on the CommonGrants protocol",
  "license": "AGPL-3.0-only",
  "repository": "github:egeria-corporation/gms",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --no-file-parallelism",
    "spec:compile": "pnpm --filter @gms/api-spec compile",
    "spec:check": "pnpm --filter @gms/api-spec check",
    "gate:sensitive": "node scripts/sensitive-data-gate.mjs",
    "gms": "node scripts/deploy/cli.ts",
    "typecheck:deploy": "tsc -p scripts/deploy/tsconfig.json",
    "dev:web": "pnpm --filter @gms/web dev",
    "dev:api": "pnpm --filter @gms/api dev",
    "ci": "pnpm typecheck && pnpm typecheck:deploy && pnpm lint && pnpm gate:sensitive && pnpm test && pnpm spec:compile && pnpm spec:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
