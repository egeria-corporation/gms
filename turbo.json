{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["GMS_*", "DATABASE_URL", "SUPABASE_*", "MERCURY_*", "RESEND_API_KEY", "SMTP_URL", "NODE_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "typecheck": { "dependsOn": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
