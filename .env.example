# GMS environment. Copy to .env and fill in what you have. Only a database is required;
# every other integration falls back to a safe fake adapter (see `pnpm run doctor`).

# --- Modes -------------------------------------------------------------------------------
# single: one foundation (self-host default). multi: tenants resolved by hostname.
GMS_MODE=multi
# Root domain for tenant subdomains ({slug}.{GMS_ROOT_DOMAIN}); local dev uses localhost:3000.
GMS_ROOT_DOMAIN=localhost:3000
# Tenant used in single mode (and as a fallback).
DEFAULT_TENANT=halcyon
# test = TestAuthAdapter (plain Postgres tier / tests only; refused in production builds).
# supabase = Supabase Auth (default when SUPABASE_URL is set).
GMS_AUTH_MODE=test
# development | preview | staging | production. Anything but development is internet-facing: /dev routes,
# ?state= overrides and tenant override headers are off, test sign-in is refused, and the build checks that
# Supabase, email and the encryption key are configured (apps/web/lib/deploy-config.ts). Only production sends
# email to anyone; staging and previews deliver only to GMS_EMAIL_ALLOWLIST. Set it explicitly on each Netlify
# site: Netlify's CONTEXT says "production" for every site's main deploy, staging included.
GMS_ENV=development
# false = foundations are served only at {slug}.{GMS_ROOT_DOMAIN} (the hosted service); they can request a custom
# deployment from Settings. Default true: verified custom domains (workspace_domains) resolve to their tenant.
GMS_CUSTOM_DOMAINS=
# Where custom deployment requests are emailed (the platform team). Unset = operator console only.
GMS_SUPPORT_EMAIL=

# --- Database & Supabase ---------------------------------------------------------------------
# Tier 3 (embedded Postgres started by `pnpm db:up`) uses this by default:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/gms
# Tier 1/2 (Supabase):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# On Supabase: DATABASE_URL = the transaction pooler (port 6543; right for serverless requests) and
# DATABASE_SESSION_URL = the session pooler (port 5432; the job queue and migrations need a session).
DATABASE_SESSION_URL=
# Fallback when DATABASE_URL is unset.
SUPABASE_DB_URL=
# Connections per server instance (serverless: keep it small, e.g. 3).
GMS_DB_POOL_MAX=
# For `supabase db push` against the dev project:
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# vault = Supabase Vault for secrets; otherwise AES-256-GCM with GMS_ENCRYPTION_KEY.
GMS_SECRET_STORE=

# --- Security ------------------------------------------------------------------------------------
# 32 bytes, hex or base64: `openssl rand -hex 32`. Required in production.
GMS_ENCRYPTION_KEY=
# Shared secret for internal calls to Netlify background functions.
GMS_INTERNAL_SECRET=
# Step-up window (seconds) for payment approval, role changes and other people-only actions.
GMS_STEP_UP_WINDOW_S=900

# --- Payments (Mercury) ----------------------------------------------------------------------------
# fake | sandbox. Production is never used by this codebase's tests or seeds.
MERCURY_ENV=fake
MERCURY_API_TOKEN=
MERCURY_WEBHOOK_SECRET=
# Flag-gated stub (not implemented in v1): direct send via POST /account/{id}/transactions.
GMS_FEATURE_MERCURY_DIRECT_SEND=

# --- Email -------------------------------------------------------------------------------------------
# Outside production, real mailers only deliver to @resend.dev addresses or hosts in GMS_EMAIL_ALLOWLIST;
# everything else is captured in the dev outbox (/dev/mail).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_URL=
GMS_EMAIL_FROM=no-reply@gms.example
GMS_EMAIL_ALLOWLIST=

# --- Optional services -----------------------------------------------------------------------------
# host:port of a ClamAV daemon (INSTREAM). Without it uploads are marked "not scanned".
CLAMAV_HOST=
# Optional model providers for built-in assistants (off by default).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GMS_LLM_MODEL=
# live = import IRS EO BMF / Pub 78 and OFAC SDN from government sources; default uses bundled fixtures.
GMS_DILIGENCE_SOURCE=

# --- Deploy ------------------------------------------------------------------------------------------
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
GITHUB_TOKEN=
# Link for the "Powered by GMS · Source code" footer (AGPL §13).
GMS_SOURCE_URL=https://github.com/egeria-corporation/gms
